# Copy to .env.local for local development. Real values live in Vercel project settings.
# Who owns which account: docs/INFRASTRUCTURE.md

# Neon (the Vercel Marketplace integration injects both)
# pooled (PgBouncer) — runtime pg Pool in lib/db/client.ts
DATABASE_URL=
# direct — drizzle-kit migrations (scripts/migrate-if-db.mjs, pnpm db:migrate)
DATABASE_URL_UNPOOLED=

# Auth (phase 5a). Library choice — see the Better Auth proposal in docs/DECISIONS.md
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Vercel Blob (phase 5a, media)
BLOB_READ_WRITE_TOKEN=

# Resend (phase 4, email)
RESEND_API_KEY=
RESEND_FROM=

# Telegram lead notifications (phase 4). Chat id lives in the settings table, not here.
TELEGRAM_BOT_TOKEN=

# Cloudflare Turnstile (phase 4)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI gateway — Polza AI (OpenAI-compatible, billed in roubles, works from Russia). Server only.
# Key: https://polza.ai/dashboard/api-keys (pza_…). Model ids: https://polza.ai/models
POLZA_API_KEY=
AI_MODEL=anthropic/claude-opus-5.5
# Optional: another OpenAI-compatible gateway (then AI_API_KEY instead of POLZA_API_KEY) and the
# reasoning effort hint — low | medium | high, empty leaves the provider default.
AI_BASE_URL=https://polza.ai/api/v1
AI_EFFORT=low

# Public site URL: metadataBase, canonical and hreflang links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

REVALIDATE_SECRET=
IP_HASH_SALT=
