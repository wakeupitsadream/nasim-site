{
  "name": "nasim-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-if-db.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint && prettier --check . && node scripts/check-logical-css.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "pnpm@10.33.0"
}
